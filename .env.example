# 이 파일은 "어떤 이름의 값이 필요한지" 목록입니다. (값은 없음, 커밋 가능)
# 실제 값은 `.env` 파일에 직접 넣으세요. `.env`는 커밋되지 않습니다.
# 아래 이름에는 NEXT_PUBLIC_ 을 붙이지 않습니다. (붙이면 브라우저에 공개됩니다)

# ---------- 앱(서버 코드)에서 사용 ----------

# Supabase (규칙표 읽기·사용 횟수)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (이미지 생성·기대효과 문장 다듬기)
OPENAI_API_KEY=
# (선택) 문장 다듬기 모델 이름. 비워 두면 gpt-5.4-mini 를 쓴다
OPENAI_TEXT_MODEL=
# (선택) 시뮬레이션 이미지 모델 이름. 비워 두면 gpt-image-2 를 쓴다
OPENAI_IMAGE_MODEL=

# 공공 API (주소로 토지·건축물 정보 조회)
# 브이월드: 토지이용계획·공시지가·주소 검색
VWORLD_API_KEY=
# 브이월드에 등록한 서비스 주소 (개발: localhost:3000)
VWORLD_DOMAIN=
# 공공데이터포털: 국토교통부 건축HUB 건축물대장정보
DATA_GO_KR_API_KEY=

# 접속 주소를 해시할 때 섞는 임의의 긴 문자열
IP_HASH_SALT=

# ---------- 내 컴퓨터에서 CLI 작업할 때만 사용 (앱 코드에서는 안 씀) ----------

# Supabase CLI
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Vercel CLI (배포)
VERCEL_TOKEN=

# GitHub
GITHUB_TOKEN=
