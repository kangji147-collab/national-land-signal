# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 삭제 대기 파일 (사용자가 직접 확인 후 삭제)
/trash-can/

# typescript
*.tsbuildinfo
next-env.d.ts

# 시험용 원본 서류·사진 (개인 보관, 커밋 금지)
/tests/source-docs/
/tests/photos/

# 값 없는 이름 목록 파일은 커밋 허용
!.env.example
